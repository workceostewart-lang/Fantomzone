{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fantomzone-home",
  "compatibility_date": "2026-07-11",
  "routes": [
    {
      "pattern": "fantomzone.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
